	<PropertyGroup>
		<GambleUpGameExe>$(GamePath)\Gamble With Your Friends.exe</GambleUpGameExe>
		<GambleUpModsDir>$(GamePath)\Mods</GambleUpModsDir>
	</PropertyGroup>

	<!-- Fail fast with one readable message instead of ~30 missing-namespace errors. -->
	<Target Name="GambleUpCheckGamePath" BeforeTargets="BeforeCompile;ResolveAssemblyReferences">
		<Error Condition="!Exists('$(GambleUpGameExe)')"
			   Text="GambleUp: the game was not found at '$(GambleUpGameExe)'. Every assembly reference points into the game folder, so the build cannot continue. Fix it with either: dotnet build -c Release -p:GamePath=&quot;&lt;path to the folder containing 'Gamble With Your Friends.exe'&quot;  OR  set the GAMBLEUP_GAME_PATH environment variable for this machine." />
	</Target>

	<!--
		Deploy the freshly built DLL into the game's Mods folder.
		Set -p:DeployMod=false to build without installing.
	-->
	<PropertyGroup>
		<DeployMod Condition="'$(DeployMod)' == ''">true</DeployMod>
	</PropertyGroup>

	<Target Name="GambleUpDeploy" AfterTargets="Build">
		<Warning Condition="'$(DeployMod)' != 'true'"
				 Text="GambleUp: DeployMod=false, skipping copy to '$(GambleUpModsDir)'." />
		<Error Condition="'$(DeployMod)' == 'true' AND !Exists('$(GambleUpGameExe)')"
			   Text="GambleUp: game not found at '$(GambleUpGameExe)'. Build with -p:GamePath=&quot;&lt;path to the game folder&gt;&quot; or set the GAMBLEUP_GAME_PATH environment variable. The build itself succeeded; install by copying $(TargetFileName) into that game's Mods folder." />
		<MakeDir Condition="'$(DeployMod)' == 'true' AND Exists('$(GambleUpGameExe)')"
				 Directories="$(GambleUpModsDir)" />
		<Copy Condition="'$(DeployMod)' == 'true' AND Exists('$(GambleUpGameExe)')"
			  SourceFiles="$(TargetPath)"
			  DestinationFiles="$(GambleUpModsDir)\$(TargetFileName)"
			  SkipUnchangedFiles="true" />
		<Message Condition="'$(DeployMod)' == 'true' AND Exists('$(GambleUpGameExe)')"
				 Text="GambleUp: installed $(TargetFileName) to $(GambleUpModsDir)" Importance="high" />
	</Target>
